# Resumes all tuna-os Hive agents after DeepSeek peak pricing hours end.
# Off-peak resumes at UTC 04:00 and 10:00, WEEKDAYS ONLY since
# DeepSeek's 2026-08-23 policy change (weekends are all-day off-peak).
[Unit]
Description=Resume Hive agents after DeepSeek peak pricing hours end

[Service]
Type=oneshot
ExecStart=%h/.local/bin/hive-peak.sh resume
