[Unit]
Description=Check provider headroom and fail over agents that are blocked

[Timer]
# 20min matches the governor's own tempo without hammering the pane probes.
# Subscription limits move over hours, not seconds; DeepSeek balance likewise.
OnBootSec=10min
OnUnitActiveSec=20min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
