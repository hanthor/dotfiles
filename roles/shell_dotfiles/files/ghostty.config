# Managed by Ansible (roles/shell_dotfiles). Edits here are overwritten on apply.
#
# Follow the GNOME light/dark preference automatically. Ghostty watches the
# desktop color-scheme and swaps between the two themes live — no restart.
# Theme names are the exact bundled resource filenames (see `ghostty +list-themes`).
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
