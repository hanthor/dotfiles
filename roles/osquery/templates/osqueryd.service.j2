[Unit]
Description=osquery fleet inventory (local-only logging)
After=network.target

[Service]
Type=simple
ExecStart=/opt/osquery/bin/osqueryd --config_path=/etc/osquery/osquery.conf --database_path=/var/lib/osquery/osquery.db --pidfile=/run/osquery/osqueryd.pid --disable_extensions --watchdog_memory_limit=256 --logger_plugin=filesystem --logger_mode=0600
Restart=on-failure
RestartSec=10s
RuntimeDirectory=osquery
RuntimeDirectoryMode=0700
UMask=0077
Nice=10
CPUQuota=20%
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/osquery /var/log/osquery /run/osquery

[Install]
WantedBy=multi-user.target
