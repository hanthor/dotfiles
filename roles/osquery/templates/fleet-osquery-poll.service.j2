[Unit]
Description=Collect private fleet osquery snapshots using existing SSH access
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service fleet-osquery-report.service

[Service]
Type=oneshot
User={{ ansible_facts['user_id'] }}
Group={{ ansible_facts['user_gid'] }}
Environment="HOME={{ ansible_facts['env']['HOME'] }}"
Environment="PATH={{ osquery_poller_path }}"
WorkingDirectory=/opt/fleet-osquery
ExecStart=/usr/bin/python3 /opt/fleet-osquery/osquery-fleet.py --inventory /etc/fleet-osquery/inventory.yml --output "{{ osquery_poller_state_dir }}/latest.json"
TimeoutStartSec=5min
UMask=0077
Nice=10
CPUQuota=20%
MemoryMax=512M
PrivateTmp=true
ProtectSystem=full
# Local report reads use the account's existing sudo permission. Do not set
# NoNewPrivileges: that would break sudo while leaving remote reads working.
