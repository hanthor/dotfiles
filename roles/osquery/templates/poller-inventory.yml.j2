all:
  hosts:
{% for host in groups['all'] | sort %}
    {{ host | to_json }}:
{% for key in ['ansible_host', 'ansible_user', 'ansible_ssh_user', 'ansible_port', 'ansible_ssh_port', 'ansible_connection', 'tailnet_name', 'osquery_supported'] %}
{% if hostvars[host][key] is defined %}
      {{ key }}: {{ hostvars[host][key] | to_json }}
{% endif %}
{% endfor %}
{% endfor %}
  children:
{% for group in ['vps', 'test_fleet', 'termux_hosts'] %}
    {{ group }}:
{% if groups.get(group, []) %}
      hosts:
{% for host in groups[group] | sort %}
        {{ host | to_json }}: {}
{% endfor %}
{% else %}
      hosts: {}
{% endif %}
{% endfor %}
