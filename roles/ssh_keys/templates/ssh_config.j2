Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ServerAliveCountMax 3
  # Reuse connections — big speedup for repeated SSH to the same host
  ControlMaster auto
  ControlPersist 10m
  ControlPath ~/.ssh/cp/%C
  # Don't hash known_hosts so tab-completion and doctor checks work
  HashKnownHosts no
  # Compression on slow links; negligible on LAN/Tailscale
  Compression yes

{% for name, info in machines.items() %}
Host {{ name }}
  HostName {{ info.hostname }}
{% if hostvars[name] is defined and hostvars[name].ansible_port is defined %}
  Port {{ hostvars[name].ansible_port }}
{% endif %}
  User {{ hostvars[name].ansible_user | default(user_login) if hostvars[name] is defined else user_login }}
  SendEnv BW_SESSION

{% endfor %}
