# Example systemd unit for the secret-broker (Phase 1, #49).
# Copy to /etc/systemd/system/secret-broker.service on a NON-Talos always-on host
# (a VPS such as telengana or matrix — NOT bihar, which is a Talos node with no
# systemd; for in-cluster use deploy/secret-broker.k8s.yaml instead). Fill in the
# env file, then: systemctl daemon-reload && systemctl enable --now secret-broker
#
# RUNBOOK ARTIFACT — not deployed by the playbook. It handles secrets, so it stays
# a deliberate manual step until the flow has been run live at least once.

[Unit]
Description=Tailnet identity secret broker (QR onboarding, #49)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# EnvironmentFile holds TS_AUTHKEY (or none if state is pre-authed), BW_SESSION,
# BW_PASSWORD, BROKER_ADMINS, BROKER_CONFIG — root-only (0600).
EnvironmentFile=/etc/secret-broker.env
ExecStart=/usr/local/bin/secret-broker -source=bw
Restart=on-failure
RestartSec=5s

# Hardening — the broker holds unattended read access to onboarding secrets.
DynamicUser=yes
StateDirectory=secret-broker
Environment=TS_STATE_DIR=/var/lib/secret-broker
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
